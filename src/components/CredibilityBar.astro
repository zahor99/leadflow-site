---
// Proof strip — sits directly under the hero's claim and answers "who is this
// company and why believe them". First cell names the founder (the "we" of the
// hero) with his portrait; the rest are practice-level proofs. Every item is
// true and verifiable on request.
const proofs = [
  {
    lead: "In daily production",
    sub: "RAG systems inside a multi-billion-dollar manufacturer",
  },
  {
    lead: "Products of our own",
    sub: "EstateOps and ScalePod, built and run in-house",
  },
  {
    lead: "US & EU delivery",
    sub: "Named references available on request",
  },
];
---
<section class="border-y border-border bg-bg-elevated/30">
  <div class="max-w-6xl mx-auto px-6 py-12">
    <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1.1fr_1fr] gap-y-8 lg:divide-x lg:divide-border">
      <div class="px-2 sm:px-6 lg:px-8 flex items-center gap-4">
        <img
          src={`${import.meta.env.BASE_URL}images/gergely-racz.webp`}
          alt="Gergely Racz, founder"
          width="48"
          height="48"
          loading="lazy"
          class="flex-shrink-0 w-12 h-12 rounded-full object-cover border border-border"
        />
        <div>
          <dt class="text-text-primary font-semibold text-base tracking-tight">
            <a href="#founder" class="hover:text-accent-hover transition-colors">Founder-led</a>
          </dt>
          <dd class="mt-1.5 text-text-secondary text-sm leading-relaxed">
            Gergely Racz: Cambridge PhD, 10+ years in AI
          </dd>
        </div>
      </div>
      {proofs.map((p) => (
        <div class="px-2 sm:px-6 lg:px-8">
          <dt class="text-text-primary font-semibold text-base tracking-tight">{p.lead}</dt>
          <dd class="mt-1.5 text-text-secondary text-sm leading-relaxed">{p.sub}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
