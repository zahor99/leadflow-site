---
// One category, every sample (EN /work/<slug>/, HU /hu/work/<slug>/). Documents with a highlight get a wide row:
// cover + the strongest crop + what it shows, so the quality is visible before anyone opens the file.
import WorkFrame from "../WorkFrame.astro";
import { categories, t, ui, type Lang, type Sample } from "../../data/samples";
import sizes from "../../data/img-sizes.json";
const wh = (src: string) => { const d = (sizes as Record<string, number[]>)[src]; return d ? { width: d[0], height: d[1] } : {}; };

interface Props { lang: Lang; slug: string }
const { lang, slug } = Astro.props;
const U = ui[lang];
const base = lang === "hu" ? "/hu" : "";
const cat = categories.find((c) => c.slug === slug)!;
const others = categories.filter((c) => c.slug !== slug);
const shape = (s: Sample) => s.shape ?? (s.video ? "portrait" : "doc");
const isArticle = (s: Sample) => s.href?.startsWith("/blog/") || s.href === "/#work";
const featured = cat.items.filter((s) => s.hl && !s.video && s.href?.endsWith(".pdf"));
const rest = cat.items.filter((s) => !featured.includes(s));
const T = lang === "hu"
  ? { suffix: "munkaminták", seo: "Hamarosan Claude-csatlakozóként is elérhető:", seoLink: "a SEO Desk bemutatása", note: "A minták angol nyelvűek." }
  : { suffix: "work samples", seo: "Coming as a Claude connector:", seoLink: "see the SEO Desk", note: "" };
---

<WorkFrame title={`${t(cat.title, lang)}: ${T.suffix}`} description={t(cat.blurb, lang)} lang={lang}>
  <section class="wf-wrap head">
    <a class="back" href={`${base}/work/#${cat.slug}`}>← {U.all}</a>
    <h1>{t(cat.title, lang)}</h1>
    <p class="lede">{t(cat.blurb, lang)}{T.note && <>{" "}{T.note}</>}</p>
    {cat.slug === "seo" && <p class="price">{T.seo} <a href={`${base}/seo-desk/`}>{T.seoLink} →</a></p>}
    {(cat.anchors ?? []).map((a) => <span id={a}></span>)}
  </section>

  {featured.length > 0 && (
    <section class="wf-wrap feats">
      {featured.map((s) => (
        <article class="feat" id={s.id}>
          <a class="cover" href={s.href} target="_blank" rel="noopener" aria-label={`${U.openReport}: ${t(s.title, lang)}`}>
            <img src={s.img} alt="" loading="lazy" decoding="async" />
          </a>
          <div class="body">
            <p class="kind">{t(s.kind, lang)}{lang === "hu" && !s.noText && <span class="en-tag">{U.assetLang}</span>}</p>
            <h2>{t(s.title, lang)}</h2>
            {s.meta && <p class="meta">{t(s.meta, lang)}</p>}
            <figure>
              <a class="hl" href={s.href} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true"><picture>{s.hl!.m && <source media="(max-width: 600px)" srcset={s.hl!.m} {...wh(s.hl!.m)} />}<img src={s.hl!.img} alt="" loading="lazy" decoding="async" {...wh(s.hl!.img)} /></picture></a>
              <figcaption>{t(s.hl!.cap, lang)}</figcaption>
            </figure>
            <p class="links">
              <a class="act" href={s.href} target="_blank" rel="noopener">{U.openReport} <span aria-hidden="true">→</span></a>
              {s.extra?.map((x) => <a href={x.href} target="_blank" rel="noopener">{t(x.label, lang)}</a>)}
            </p>
          </div>
        </article>
      ))}
    </section>
  )}

  {rest.length > 0 && (
    <section class="wf-wrap">
      <ul class="grid">
        {rest.map((s) => (
          <li class={`it ${shape(s)}`} id={s.id}>
            {s.video ? (
              <button type="button" class="open" data-video={s.video} data-poster={s.img} data-title={t(s.title, lang)} aria-label={`${U.play}: ${t(s.title, lang)}`}>
                <span class="thumb"><img src={s.img} alt="" loading="lazy" decoding="async" />
                  <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span></span>
                <span class="kind">{t(s.kind, lang)}</span><span class="name">{t(s.title, lang)}</span>{s.meta && <span class="meta">{t(s.meta, lang)}</span>}
              </button>
            ) : (
              <a class="open" href={s.href} target={isArticle(s) ? undefined : "_blank"} rel={isArticle(s) ? undefined : "noopener"}>
                <span class="thumb"><img src={s.img} alt="" loading="lazy" decoding="async" /></span>
                <span class="kind">{t(s.kind, lang)}</span><span class="name">{t(s.title, lang)}</span>{s.meta && <span class="meta">{t(s.meta, lang)}</span>}
              </a>
            )}
            {lang === "hu" && !s.noText && <span class="en-tag">{U.assetLang}</span>}
            {s.extra && <span class="extra">{s.extra.map((x) => <a href={x.href} target="_blank" rel="noopener">{t(x.label, lang)}</a>)}</span>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="wf-wrap more" aria-labelledby="more-title">
    <h2 id="more-title">{U.more}</h2>
    <div class="chips">{others.map((c) => <a href={`${base}/work/${c.slug}/`}>{t(c.title, lang)} <span>{c.items.length}</span></a>)}</div>
  </section>
</WorkFrame>

<style>
  .head { padding-block: clamp(36px, 5vw, 72px) clamp(24px, 3vw, 40px); }
  .back { font-size: 14px; color: #b4b4c2; text-decoration: none; }
  .back:hover { color: var(--color-accent); }
  h1 { font-size: clamp(36px, 5vw, 60px); line-height: 1.04; letter-spacing: -0.03em; margin: 16px 0; text-wrap: balance; }
  .lede { font-size: 17.5px; line-height: 1.7; color: #b4b4c2; max-width: 62ch; margin: 0; text-wrap: pretty; }
  .price { margin: 16px 0 0; font-size: 15.5px; color: var(--color-text-primary); }
  .price a { color: var(--color-accent); text-decoration: none; }

  .feats { display: grid; gap: 20px; padding-bottom: 36px; }
  .feat { display: grid; grid-template-columns: minmax(150px, 220px) minmax(0, 1fr); gap: clamp(18px, 3vw, 36px); padding: clamp(16px, 2.4vw, 28px);
    border-radius: 18px; background: var(--color-bg-elevated); border: 1px solid var(--color-border); scroll-margin-top: 90px; }
  @media (max-width: 680px) { .feat { grid-template-columns: minmax(0, 1fr); } .cover { max-width: 180px; } }
  .cover { display: block; border-radius: 10px; overflow: hidden; border: 1px solid var(--color-border); aspect-ratio: 3 / 4; align-self: start; transition: transform .35s cubic-bezier(.22, 1, .36, 1); }
  .cover:hover { transform: translateY(-3px); }
  .cover img, .hl img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .body { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .body .kind { margin: 0; font-size: 12.5px; font-weight: 600; color: var(--color-accent); }
  .body h2 { margin: 0; font-size: clamp(20px, 2.2vw, 26px); line-height: 1.2; letter-spacing: -0.015em; text-wrap: balance; }
  .body .meta { margin: 0; font-size: 14.5px; color: #a8a8b8; }
  figure { margin: 8px 0 0; display: grid; gap: 10px; }
  .hl { display: block; border-radius: 10px; overflow: hidden; background: #fff; max-height: 540px; border: 1px solid var(--color-border); }
  .hl picture { display: block; }
  @media (max-width: 600px) { .hl, .hl img { max-height: none; } .hl img { object-fit: contain; } }
  .hl img { height: auto; max-height: 540px; }
  figcaption { font-size: 15px; line-height: 1.55; color: var(--color-text-primary); max-width: 70ch; }
  .links { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 4px 0 0; font-size: 14px; }
  .links a { color: var(--color-accent); text-decoration: none; font-weight: 600; }
  .links a:hover { color: var(--color-accent-hover); }
  .links a:focus-visible, .cover:focus-visible, .back:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; border-radius: 6px; }

  .grid { list-style: none; margin: 0; padding: 4px 0 32px; display: grid; gap: 32px 22px; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); align-items: start; }
  .it.wide { grid-column: span 2; }
  @media (max-width: 480px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 12px; } .it.wide { grid-column: 1 / -1; } }
  .it { display: flex; flex-direction: column; gap: 8px; scroll-margin-top: 90px; }
  .open { all: unset; cursor: pointer; display: flex; flex-direction: column; gap: 6px; border-radius: 12px; }
  .open:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .thumb { position: relative; display: block; overflow: hidden; border-radius: 10px; background: var(--color-bg-subtle); border: 1px solid var(--color-border);
    transition: border-color .2s, transform .35s cubic-bezier(.22, 1, .36, 1); }
  .doc .thumb { aspect-ratio: 3 / 4; } .portrait .thumb { aspect-ratio: 4 / 5; } .wide .thumb { aspect-ratio: 16 / 9; } .square .thumb { aspect-ratio: 1; }
  .portrait .open[data-video] .thumb { aspect-ratio: 9 / 16; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .open:hover .thumb { border-color: var(--color-accent); transform: translateY(-3px); }
  .play { position: absolute; left: 10px; bottom: 10px; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center;
    background: rgb(10 10 15 / .74); border: 1px solid rgb(255 255 255 / .2); }
  .play svg { width: 16px; height: 16px; fill: #fff; margin-left: 2px; }
  .kind { font-size: 12px; font-weight: 600; color: var(--color-accent); }
  .name { font-size: 15.5px; font-weight: 650; line-height: 1.35; color: var(--color-text-primary); text-wrap: pretty; }
  .meta { font-size: 13.5px; color: #a8a8b8; line-height: 1.45; }
  .en-tag { display: inline-block; width: fit-content; font-size: 11px; font-weight: 600; color: var(--color-text-secondary); border: 1px solid var(--color-border); border-radius: 999px; padding: 1px 8px; }
  .kind .en-tag { margin-left: 8px; }
  .extra { display: flex; gap: 12px; font-size: 13px; } .extra a { color: var(--color-accent); text-decoration: none; }

  .more { padding-block: 28px 56px; border-top: 1px solid var(--color-border); margin-top: 8px; }
  .more h2 { font-size: 21px; margin: 18px 0 16px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a { font-size: 14px; color: var(--color-text-primary); text-decoration: none; padding: 8px 14px; border-radius: 999px; border: 1px solid var(--color-border); background: var(--color-bg-elevated); transition: border-color .2s; }
  .chips a:hover, .chips a:focus-visible { border-color: var(--color-accent); outline: none; }
  .chips span { color: var(--color-text-secondary); font-size: 12.5px; margin-left: 4px; }
  @media (prefers-reduced-motion: reduce) { .cover, .thumb { transition: none; } }
</style>
