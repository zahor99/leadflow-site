      <!-- Diagram 4: one long recording into many pieces -->
      <svg class="dia mach" viewBox="0 0 640 330" role="img" aria-label={`${M.src} → ${M.outs.join(", ")}`}>
        <defs><marker id="ah4" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0l10 5-10 5z" fill="#2E9BE8" /></marker></defs>
        <rect class="src" x="20" y="20" width="600" height="56" rx="12" />
        <text class="st" x="40" y="54">{M.src}</text>
        {[[250, 48], [330, 30], [392, 56], [470, 36], [540, 44]].map(([x, w]) => <rect class="seg" x={x} y="38" width={w} height="20" rx="4" />)}
        {M.outs.map((t, i) => { const x = 20 + i * 102; return (<g>
          <path class="ln" d={`M${[274, 345, 420, 345, 488, 562][i]} 78 C ${[274, 345, 420, 345, 488, 562][i]} 120, ${x + 46} 110, ${x + 46} 140`} marker-end="url(#ah4)" />
          <rect class={i < 4 ? "phoneR" : "docR"} x={x} y="146" width="92" height={i < 4 ? 150 : 120} rx={i < 4 ? 14 : 8} />
          {i < 4 ? <><clipPath id={`scr${i}`}><rect x={x + 8} y="156" width="76" height="104" rx="8" /></clipPath><rect class="scr" x={x + 8} y="156" width="76" height="104" rx="8" /><image href={thumbs[i]} x={x + 8} y="156" width="76" height="104" preserveAspectRatio="xMidYMid slice" clip-path={`url(#scr${i})`} /></>
                 : <><rect class="line1" x={x + 12} y="162" width="68" height="8" rx="3" /><rect class="line2" x={x + 12} y="180" width="56" height="6" rx="3" /><rect class="line2" x={x + 12} y="194" width="62" height="6" rx="3" /><rect class="line2" x={x + 12} y="208" width="48" height="6" rx="3" /></>}
          <text class="ot" x={x + 46} y={i < 4 ? 284 : 254} text-anchor="middle">{t}</text></g>); })}
        <text class="ss" x="620" y="322" text-anchor="end">{M.note}</text>
      </svg>
