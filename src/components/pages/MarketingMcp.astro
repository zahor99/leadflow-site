---

<WorkFrame title={C.title} description={C.desc} lang={lang} cta={false}>
  <section class="hero">
    <div class="wf-wrap hero-in">
      <div class="copy">
        <p class="tag">{C.tag}</p>
        <p class="status">{C.status}</p>
        <h1>{C.h1}</h1>
        <p class="lede">{C.lede}</p>
        <div class="actions">
          <a class="btn" href="#sample">{C.ctaA}</a>
          <a class="ghost" href="#samples">{C.ctaB}</a>
        </div>
      </div>
      <figure class="machine" aria-label={C.mCap}>
        <figcaption>{C.mCap}</figcaption>
        <p class="mh">{C.mIn}</p>
        <ul class="ins">{C.mInItems.map((x) => <li>{x}</li>)}</ul>
        <div class="arrow" aria-hidden="true">↓</div>
        <p class="mh">{C.mOut}</p>
        <ul class="outs">{C.mOutItems.map((x) => <li>{x}</li>)}</ul>
        <p class="mfoot">{C.mFoot}</p>
      </figure>
    </div>
  </section>

  <section class="wf-wrap band">
    <h2>{C.brainH}</h2>
    <p class="intro">{C.brainP}</p>
    <dl class="cards">{C.brain.map(([a, b]) => (<div><dt>{a}</dt><dd>{b}</dd></div>))}</dl>
  </section>

  <section class="wf-wrap band">
    <h2>{C.machineH}</h2>
    <p class="intro">{C.machineP}</p>
    <div class="machine-grid">
      <dl class="cards two">{C.machine.map(([a, b]) => (<div><dt>{a}</dt><dd>{b}</dd></div>))}</dl>
      <figure class="mech">
        <video src="/work/videos/skin-mechanism.mp4" poster="/work/videos/skin-mechanism.jpg" muted loop playsinline autoplay preload="metadata"></video>
        <figcaption>{C.mechCap}</figcaption>
      </figure>
    </div>
  </section>

  <section class="wf-wrap band">
    <h2>{C.mcpH}</h2>
    <p class="intro">{C.mcpP}</p>
    <div class="tablewrap">
      <table>
        <thead><tr>{C.mcpTh.map((h) => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>{C.mcpRows.map(([a, b, c]) => (<tr><th scope="row">{a}</th><td>{b}</td><td><span class:list={["chip", { live: c.startsWith("live") || c.startsWith("működik") }]}>{c}</span></td></tr>))}</tbody>
      </table>
    </div>
    <p class="more"><a href={`${base}/seo-desk/`}>{C.mcpLink} →</a></p>
  </section>

  <section class="wf-wrap band">
    <h2>{C.stepsH}</h2>
    <ol class="steps">{C.steps.map(([a, b]) => (<li><b>{a}</b> {b}</li>))}</ol>
  </section>

  <section class="wf-wrap band" id="pricing">
    <h2>{C.priceH}</h2>
    <div class="typical">{C.price.map(([a, b, href, link]) => (<p><b>{a}</b><span>{b}</span><a href={href}>{link} →</a></p>))}</div>
  </section>

  <section class="wf-wrap band" id="samples">
    <h2>{C.samplesH}</h2>
    <p class="intro">{C.samplesP}</p>
  </section>
  <div class="wf-wrap shelves">
    <SampleShelf category={video} lang={lang} eager />
    <SampleShelf category={social} lang={lang} />
    <SampleShelf category={papers} lang={lang} />
    <SampleShelf category={seo} lang={lang} />
  </div>

  <section class="wf-wrap band">
    <h2>{C.faqH}</h2>
    <dl class="faq">{C.faq.map(([q, a]) => (<div><dt>{q}</dt><dd>{a}</dd></div>))}</dl>
  </section>

  <section class="wf-wrap" id="sample">
    <div class="wait">
      <div class="wait-copy">
        <h2>{C.formH}</h2>
        <p>{C.formP}</p>
      </div>
      <form id="wl" novalidate>
        <div class="row">
          <label>{C.f.email}<input name="email" type="email" required autocomplete="email" aria-describedby="err-email" /><span class="err" id="err-email" aria-live="polite"></span></label>
          <label>{C.f.site}<input name="site" type="text" required placeholder={C.f.sitePh} aria-describedby="err-site" /><span class="err" id="err-site" aria-live="polite"></span></label>
        </div>
        <label>{C.f.vid}<input name="video" type="text" placeholder={C.f.vidPh} /></label>
        <label>{C.f.note}<input name="note" type="text" placeholder={C.f.notePh} /></label>
        <label class="hp" aria-hidden="true">Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
        <button type="submit">{C.f.btn}</button>
        <p class="msg" id="wl-msg" role="status"></p>
        <p class="small">{C.f.priv} <a href="/privacy/">{C.f.privLink}</a></p>
      </form>
    </div>
  </section>

  <script define:vars={{ WAITLIST_URL, M: C.msg, PAGE: C.page }}>
    const form = document.getElementById("wl");
    const msg = document.getElementById("wl-msg");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = Object.fromEntries(new FormData(form).entries());
      const errs = {
        email: /^[^@\s]+@[^@\s]+\.[A-Za-z]{2,}$/.test(f.email || "") ? "" : M.email,
        site: String(f.site || "").trim() ? "" : M.site,
      };
      let first = null;
      for (const [k, v] of Object.entries(errs)) {
        const input = form.elements.namedItem(k);
        document.getElementById("err-" + k).textContent = v;
        input.setAttribute("aria-invalid", v ? "true" : "false");
        if (v && !first) first = input;
      }
      msg.textContent = "";
      if (first) { first.focus(); return; }
