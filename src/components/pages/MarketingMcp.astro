---
// Marketing MCP / Agency OS sales page body (EN /marketing-mcp/, HU /hu/marketing-mcp/).
// v2 (operator 2026-11-11: "lots of words and not very convincing ... it is a proper marketing agency"):
// positioned as an AI marketing agency (analyse, generate, monitor, report), not a repurposing tool.
// Visual-first: inline SVG diagrams in the site palette (agency system, AI brain ingestion, work loop, content
// machine), agent team as icon cards, samples as carousels. Honest status: SEO Desk live in Claude for invited
// sites; research, social listening and content are delivered as a service on the same system while the
// connector tools are built. noindex until the terms are final. CTA posts to the VPS waitlist service.
import WorkFrame from "../WorkFrame.astro";
import SampleShelf from "../SampleShelf.astro";
import { bySlug, type Lang } from "../../data/samples";

interface Props { lang: Lang }
const { lang } = Astro.props;
const WAITLIST_URL = "https://ops.leadflowautomation.net/waitlist/signup";
const base = lang === "hu" ? "/hu" : "";
const shelves = ["video", "social", "research", "seo", "papers"].map((s) => bySlug(s)!);

