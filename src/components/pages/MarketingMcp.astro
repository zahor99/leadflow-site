const S = C.sys, I = C.ing, M = C.mach;
// loop geometry: six nodes on a circle around the brain
const R = 150, cx = 300, cy = 210;
const nodes = C.loop.map((label, i) => { const a = (-90 + i * 60) * Math.PI / 180; return { label, x: cx + R * Math.cos(a), y: cy + R * Math.sin(a) }; });
const thumbs = ["/work/videos/scalepod-ugc-poster.jpg", "/work/gallery/social/skincare-glow-ritual.webp", "/work/gallery/social/medspa-myth-or-fact.webp", "/work/gallery/social/coach-ig-post.webp"];
const icons = [
  "M11 4a7 7 0 1 0 4.2 12.6l4.6 4.6 1.4-1.4-4.6-4.6A7 7 0 0 0 11 4zm0 2a5 5 0 1 1 0 10 5 5 0 0 1 0-10z",
  "M4 19h16v2H4zM6 10h3v7H6zm5-4h3v11h-3zm5 6h3v5h-3z",
  "M4 5h16v14H4zm2 2v10h12V7zm3 2 5 3-5 3z",
  "M12 2 4 5v6c0 5 3.4 9.4 8 11 4.6-1.6 8-6 8-11V5zm-1 13-3.5-3.5 1.4-1.4L11 12.2l4.6-4.6L17 9z",
  "M3 11l18-8-8 18-2-8z",
  "M12 5C6.5 5 2.7 9.4 1.5 12c1.2 2.6 5 7 10.5 7s9.3-4.4 10.5-7C21.3 9.4 17.5 5 12 5zm0 11a4 4 0 1 1 0-8 4 4 0 0 1 0 8z",
];
---

<WorkFrame title={C.title} description={C.desc} lang={lang} cta={false}>
  <section class="hero">
    <div class="wf-wrap hero-in">
      <div class="copy">
        <p class="tag">{C.tag}</p>
        <h1>{C.h1}</h1>
        <p class="lede">{C.lede}</p>
        <div class="actions">
          <a class="btn" href="#sample">{C.ctaA}</a>
          <a class="ghost" href="#work">{C.ctaB}</a>
        </div>
      </div>

      <!-- Diagram 1: the agency system -->
      <svg class="dia sys" viewBox="0 0 560 600" role="img" aria-label={`${S.inputs}: ${S.in.join(", ")} → ${S.brain} → ${S.team}: ${S.agents.join(", ")} → ${S.gate} → ${S.out.join(", ")}`}>
        <defs>
          <linearGradient id="g-brain" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#2E9BE8" /><stop offset="1" stop-color="#F0257F" /></linearGradient>
          <marker id="ah" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0l10 5-10 5z" fill="#2E9BE8" /></marker>
        </defs>
        <text class="lbl" x="20" y="26">{S.inputs}</text>
        {S.in.map((t, i) => (<g><rect class="pill" x={20 + i * 132} y="40" width="122" height="40" rx="20" /><text class="pt" x={81 + i * 132} y="65" text-anchor="middle">{t}</text>
          <path class="ln" d={`M${81 + i * 132} 82 C ${81 + i * 132} 120, 280 110, 280 146`} marker-end="url(#ah)" /></g>))}
        <rect x="150" y="150" width="260" height="92" rx="20" fill="url(#g-brain)" opacity=".16" />
        <rect class="brain" x="150" y="150" width="260" height="92" rx="20" />
        <text class="bt" x="280" y="190" text-anchor="middle">{S.brain}</text>
        <text class="bs" x="280" y="218" text-anchor="middle">{S.brainSub}</text>
        <path class="ln" d="M280 244 V 282" marker-end="url(#ah)" />
        <text class="lbl" x="20" y="300">{S.team}</text>
        {S.agents.map((t, i) => { const col = i % 3, row = Math.floor(i / 3); return (
          <g><rect class="agent" x={20 + col * 176} y={312 + row * 58} width="166" height="46" rx="10" />
            <circle cx={42 + col * 176} cy={335 + row * 58} r="6" class="dot" /><text class="at" x={56 + col * 176} y={340 + row * 58}>{t}</text></g>); })}
        <path class="ln" d="M280 430 V 462" marker-end="url(#ah)" />
        <rect class="gate" x="140" y="466" width="280" height="42" rx="21" />
        <text class="gt" x="280" y="493" text-anchor="middle">✓ {S.gate}</text>
        {S.out.map((t, i) => (<g><path class="ln" d={`M280 510 C 280 534, ${81 + i * 132} 524, ${81 + i * 132} 546`} marker-end="url(#ah)" />
          <rect class="outp" x={20 + i * 132} y="550" width="122" height="36" rx="8" /><text class="pt" x={81 + i * 132} y="573" text-anchor="middle">{t}</text></g>))}
      </svg>
    </div>
  </section>

  <section class="wf-wrap verbs" aria-label="Analyse, generate, monitor, report">
    {C.verbs.map(([a, b], i) => (
      <div class="verb"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={[icons[0], icons[2], icons[5], icons[1]][i]} /></svg><b>{a}</b><span>{b}</span></div>))}
  </section>

  <section class="wf-wrap band">
    <div class="split">
      <div>
        <h2>{C.brainH}</h2>
        <p class="intro">{C.brainP}</p>
      </div>
      <!-- Diagram 2: ingestion into the AI brain -->
      <svg class="dia ing" viewBox="0 0 600 360" role="img" aria-label={`${I.title}: ${I.brand}, ${I.icp}, ${I.claims}, ${I.market} → ${I.brain} → ${I.uses}`}>
        <defs><marker id="ah2" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0l10 5-10 5z" fill="#2E9BE8" /></marker>
          <radialGradient id="g-core"><stop offset="0" stop-color="#2E9BE8" stop-opacity=".45" /><stop offset="1" stop-color="#2E9BE8" stop-opacity="0" /></radialGradient></defs>
        {[[I.brand, I.brandI], [I.icp, I.icpI], [I.claims, I.claimsI], [I.market, I.marketI]].map(([t, s], i) => (
          <g><rect class="src" x="6" y={18 + i * 84} width="262" height="66" rx="12" /><text class="st" x="22" y={46 + i * 84}>{t}</text><text class="ss sm" x="22" y={68 + i * 84}>{s}</text>
            <path class="ln" d={`M270 ${51 + i * 84} C 310 ${51 + i * 84}, 310 180, 346 180`} marker-end="url(#ah2)" /></g>))}
        <circle cx="420" cy="180" r="92" fill="url(#g-core)" />
        <circle class="core" cx="420" cy="180" r="70" />
        <text class="bt" x="420" y="186" text-anchor="middle">{I.brain}</text>
        <text class="ss" x="420" y="292" text-anchor="middle">{I.uses}</text>
        {I.u.map((t, i) => (<g><rect class="use" x={330 + (i % 2) * 94} y={304 + Math.floor(i / 2) * 0} width="86" height="26" rx="13" transform={`translate(0 ${Math.floor(i / 2) * 30})`} />
          <text class="ut" x={373 + (i % 2) * 94} y={321 + Math.floor(i / 2) * 30} text-anchor="middle">{t}</text></g>))}
      </svg>
    </div>
  </section>

  <section class="wf-wrap band">
    <h2>{C.teamH}</h2>
    <p class="intro">{C.teamP}</p>
    <div class="team">
      {C.team.map(([a, b], i) => (
        <div class="member"><span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={icons[i]} /></svg></span><b>{a}</b><p>{b}</p></div>))}
    </div>
  </section>

  <section class="wf-wrap band">
    <div class="split rev">
      <!-- Diagram 3: the monthly loop -->
      <svg class="dia loop" viewBox="0 0 600 420" role="img" aria-label={`${C.loopH}: ${C.loop.join(" → ")} → ${C.loopC}`}>
        <defs><marker id="ah3" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0l10 5-10 5z" fill="#2E9BE8" /></marker></defs>
        <circle class="orbit" cx={cx} cy={cy} r={R} />
        {nodes.map((n, i) => { const m = nodes[(i + 1) % nodes.length]; const ax = n.x + (m.x - n.x) * 0.3, ay = n.y + (m.y - n.y) * 0.3, bx = n.x + (m.x - n.x) * 0.7, by = n.y + (m.y - n.y) * 0.7;
          return (<g><path class="ln" d={`M${ax.toFixed(1)} ${ay.toFixed(1)} L ${bx.toFixed(1)} ${by.toFixed(1)}`} marker-end="url(#ah3)" />
            <rect class={i === 3 ? "node gateN" : "node"} x={n.x - 62} y={n.y - 20} width="124" height="40" rx="20" />
            <text class="nt" x={n.x} y={n.y + 5} text-anchor="middle">{n.label}</text></g>); })}
        <circle class="core" cx={cx} cy={cy} r="58" />
        <text class="bt sm" x={cx} y={cy + 2} text-anchor="middle">{C.loopC}</text>
        <text class="ss" x={cx} y={cy + 24} text-anchor="middle">{C.loopSub}</text>
