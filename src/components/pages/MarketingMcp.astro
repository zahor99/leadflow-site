    msg: { email: "Kérjük, adjon meg érvényes e-mail-címet.", site: "Kérjük, adja meg a weboldala címét.", sending: "Küldés…", ok: "Köszönjük. Hamarosan jelentkezünk a mintával.", err: "Valami hiba történt. Kérjük, próbálja újra.", net: "Hálózati hiba. Kérjük, próbálja újra." },
    page: "marketing-mcp-hu",
  },
