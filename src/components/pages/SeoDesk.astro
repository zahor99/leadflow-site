---

<WorkFrame title={C.title} description={C.desc} lang={lang} cta={false}>
  <section class="hero">
    <div class="wf-wrap hero-in">
      <div class="copy">
        <p class="tag">{C.tag}</p>
        <p class="status">{C.status}</p>
        <h1>{C.h1}</h1>
        <p class="lede">{C.lede}</p>
        <div class="actions">
          <a class="btn" href="#sample">{C.ctaA}</a>
          <a class="ghost" href="#pricing">{C.ctaB}</a>
        </div>
      </div>

      <figure class="digest" aria-label={C.dCap}>
        <figcaption>{C.dCap}</figcaption>
        <p class="dh">{C.dChanged}</p>
        <ul class="moves">{C.moves.map(([k, v, txt]) => (<li><b class={k}>{v}</b><span>{txt}</span></li>))}</ul>
        <p class="dh">{C.dFix}</p>
        <ol class="fixes">{C.fixes.map(([a, b]) => (<li><b>{a}</b> {b}</li>))}</ol>
      </figure>
    </div>
  </section>

  <section class="wf-wrap band">
    <h2>{C.checksH}</h2>
    <dl class="checks">{C.checks.map(([a, b]) => (<div><dt>{a}</dt><dd>{b}</dd></div>))}</dl>
  </section>

  <section class="wf-wrap band">
    <h2>{C.stepsH}</h2>
    <ol class="steps">{C.steps.map(([a, b]) => (<li><b>{a}</b> {b}</li>))}</ol>
  </section>

  <section class="wf-wrap band" id="pricing">
    <h2>{C.priceH}</h2>
    <p class="note">{C.priceNote}</p>
    <div class="tablewrap">
      <table>
        <thead><tr>{C.th.map((h) => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>{C.rows.map(([a, b, c]) => (<tr><th scope="row">{a}</th><td>{b}</td><td>{c}</td></tr>))}</tbody>
      </table>
    </div>
    <div class="typical">{C.typical.map(([a, b]) => (<p><b>{a}</b><span>{b}</span></p>))}</div>
  </section>

  <div class="wf-wrap"><SampleShelf category={seo} lang={lang} title={C.shelfTitle} blurb={C.shelfBlurb} /></div>

  <section class="wf-wrap band">
    <h2>{C.faqH}</h2>
    <dl class="faq">{C.faq.map(([q, a]) => (<div><dt>{q}</dt><dd>{a}</dd></div>))}</dl>
  </section>

  <section class="wf-wrap" id="sample">
    <div class="wait">
      <div class="wait-copy">
        <h2>{C.formH}</h2>
        <p>{C.formP}</p>
      </div>
      <form id="wl" novalidate>
        <div class="row">
          <label>{C.f.email}<input name="email" type="email" required autocomplete="email" aria-describedby="err-email" /><span class="err" id="err-email" aria-live="polite"></span></label>
          <label>{C.f.site}<input name="site" type="text" required placeholder={C.f.sitePh} aria-describedby="err-site" /><span class="err" id="err-site" aria-live="polite"></span></label>
        </div>
        <div class="row">
          <label>{C.f.market}<input name="market" type="text" placeholder={C.f.marketPh} /></label>
          <label>{C.f.comp}<input name="competitors" type="text" placeholder={C.f.compPh} /></label>
        </div>
        <label>{C.f.kw}<input name="keywords" type="text" placeholder={C.f.kwPh} aria-describedby="err-keywords" /><span class="err" id="err-keywords" aria-live="polite"></span></label>
        <label class="hp" aria-hidden="true">Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
        <button type="submit">{C.f.btn}</button>
        <p class="msg" id="wl-msg" role="status"></p>
        <p class="small">{C.f.priv} <a href="/privacy/">{C.f.privLink}</a></p>
      </form>
    </div>
  </section>

  <script define:vars={{ WAITLIST_URL, M: C.msg, PAGE: C.page }}>
    const form = document.getElementById("wl");
    const msg = document.getElementById("wl-msg");
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = Object.fromEntries(new FormData(form).entries());
      const kws = String(f.keywords || "").split(",").map((k) => k.trim()).filter(Boolean);
      const errs = {
        email: /^[^@\s]+@[^@\s]+\.[A-Za-z]{2,}$/.test(f.email || "") ? "" : M.email,
        site: String(f.site || "").trim() ? "" : M.site,
        keywords: kws.length <= 10 ? "" : M.kw,
      };
      let first = null;
      for (const [k, v] of Object.entries(errs)) {
        const input = form.elements.namedItem(k);
        document.getElementById("err-" + k).textContent = v;
        input.setAttribute("aria-invalid", v ? "true" : "false");
        if (v && !first) first = input;
      }
      msg.textContent = "";
      if (first) { first.focus(); return; }
      f.keywords = kws.join(", ");
      // the waitlist service keeps email/name/company/interest; the sample request travels in `interest`
      const data = { email: f.email, company: f.site, website: f.website, page: PAGE,
        interest: `SEO Desk sample digest | site: ${f.site} | market: ${f.market || "-"} | keywords: ${f.keywords || "-"} | competitors: ${f.competitors || "-"}` };
      const btn = form.querySelector("button");
      btn.disabled = true; msg.textContent = M.sending;
      try {
        const r = await fetch(WAITLIST_URL, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data) });
        const j = await r.json().catch(() => ({}));
        if (r.ok && j.ok) { form.reset(); msg.textContent = M.ok; }
        else { msg.textContent = j.error || M.err; }
      } catch { msg.textContent = M.net; }
      finally { btn.disabled = false; }
    });
  </script>
</WorkFrame>

<style>
  .hero { padding-block: clamp(40px, 6vw, 88px) clamp(28px, 4vw, 56px); }
  .hero-in { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  @media (max-width: 920px) { .hero-in { grid-template-columns: minmax(0, 1fr); } }
  .tag { font-size: 14px; font-weight: 600; color: var(--color-accent); margin: 0 0 16px; }
  h1 { font-size: clamp(34px, 4.6vw, 56px); line-height: 1.05; letter-spacing: -0.03em; margin: 0 0 20px; text-wrap: balance; }
  .lede { font-size: clamp(16.5px, 1.4vw, 18.5px); line-height: 1.7; color: #b4b4c2; max-width: 56ch; margin: 0; text-wrap: pretty; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
  .btn, button[type="submit"] { display: inline-block; background: #1F78C1; color: #fff; text-decoration: none; font-weight: 650; font-size: 15px;
    padding: 14px 22px; border-radius: 10px; border: 0; cursor: pointer; transition: background .2s; }
  .btn:hover, button[type="submit"]:hover { background: #1A68A8; }
  .status { margin: -6px 0 16px; font-size: 14.5px; color: var(--color-text-primary); display: inline-block; padding: 5px 12px; border-radius: 999px; border: 1px solid var(--color-border); background: var(--color-bg-elevated); }
  .err { color: #ff9cc3; font-size: 13px; margin: 0; min-height: 0; }
  input[aria-invalid="true"] { border-color: #ff6fa8; }
  .ghost { display: inline-block; color: var(--color-text-primary); text-decoration: none; font-weight: 600; padding: 13px 20px; border-radius: 10px; border: 1px solid var(--color-border); }
  .ghost:hover { border-color: var(--color-accent); }
  .btn:focus-visible, .ghost:focus-visible, button:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; }

  .digest { margin: 0; padding: 22px; border-radius: 16px; background: var(--color-bg-elevated); border: 1px solid var(--color-border);
    box-shadow: 0 30px 60px -40px color-mix(in oklch, var(--color-accent) 70%, transparent); animation: lift .9s cubic-bezier(.22, 1, .36, 1) .1s both; }
  @keyframes lift { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  .digest figcaption { font-size: 12.5px; color: #a8a8b8; display: flex; align-items: center; gap: 8px; }
  .dot { width: 8px; height: 8px; flex: none; border-radius: 50%; background: var(--color-success); box-shadow: 0 0 0 4px color-mix(in oklch, var(--color-success) 20%, transparent); }
  .dh { margin: 18px 0 8px; font-weight: 700; font-size: 15px; color: var(--color-text-primary); }
  .moves { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .moves li { display: grid; grid-template-columns: 86px minmax(0, 1fr); gap: 10px; align-items: baseline; font-size: 14px; color: #b4b4c2; line-height: 1.45; }
  .moves b { font-variant-numeric: tabular-nums; font-size: 13px; padding: 2px 8px; border-radius: 6px; text-align: center; }
  .up { color: #7ee2a0; background: color-mix(in oklch, var(--color-success) 16%, transparent); }
