---
// Shared frame for the samples hub, the category pages and the SEO Desk page, in English and Hungarian:
// slim header with a language switch (same page, other language), booking call to action, footer, video dialog.
// Unlisted pages (noindex), like the rest of the work/ section.
import Base from "../layouts/Base.astro";
import VideoDialog from "./VideoDialog.astro";
import { otherLangPath, type Lang } from "../data/samples";

interface Props { title: string; description: string; lang?: Lang; noindex?: boolean; cta?: boolean }
const { title, description, lang = "en", noindex = true, cta = true } = Astro.props;
const path = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const other: Lang = lang === "en" ? "hu" : "en";
const otherPath = otherLangPath(path, lang);
const enPath = lang === "en" ? path : otherPath;
const huPath = lang === "hu" ? path : otherPath;
const base = lang === "hu" ? "/hu" : "";
const T = {
  en: { samples: "Samples", seo: "SEO Desk", eng: "Engineering", switchLabel: "Magyar nyelvű változat",
        ctaTitle: "Want one of these for your brand?",
        ctaBody: "Tell me what you need on a 30-minute call. You talk to the engineer who builds it, and you get a quote before anything is made.",
        ctaBtn: "Book a 30-minute call", priv: "Privacy" },
  hu: { samples: "Minták", seo: "SEO Desk", eng: "Fejlesztés", switchLabel: "English version",
        ctaTitle: "Ilyet szeretne a saját márkájának?",
        ctaBody: "Mondja el egy 30 perces beszélgetésen, mire van szüksége. Azzal a mérnökkel beszél, aki elkészíti, és árajánlatot kap, mielőtt bármi elkészülne.",
        ctaBtn: "30 perces időpont foglalása", priv: "Adatvédelem" },
}[lang];
const links = [
  { href: `${base}/work/`, label: T.samples },
  { href: `${base}/seo-desk/`, label: T.seo },
  { href: "/", label: T.eng },
];
---

<Base title={title} description={description} noindex={noindex} lang={lang}
      alternates={[{ lang: "en", href: enPath }, { lang: "hu", href: huPath }, { lang: "x-default", href: enPath }]}>
  <a class="wf-skip" href="#wf-main">{lang === "hu" ? "Ugrás a tartalomra" : "Skip to content"}</a>
  <header class="wf-top">
    <div class="wf-wrap wf-bar">
      <a class="wf-mark" href="/">LEADFLOW<span>AUTOMATION</span></a>
      <div class="wf-right">
        <nav aria-label={lang === "hu" ? "Szakasz" : "Section"}>
          {links.map((l) => (<a href={l.href} aria-current={path === l.href ? "page" : undefined}>{l.label}</a>))}
        </nav>
        <a class="wf-lang" href={otherPath} hreflang={other} lang={other} aria-label={T.switchLabel} data-lang-switch>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" /></svg>
          <span>{other.toUpperCase()}</span>
        </a>
      </div>
    </div>
  </header>

  <main class="wf-main" id="wf-main"><slot /></main>

  {cta && (
    <section class="wf-cta" aria-labelledby="wf-cta-title">
      <div class="wf-wrap wf-cta-in">
        <div>
          <h2 id="wf-cta-title">{T.ctaTitle}</h2>
          <p>{T.ctaBody}</p>
        </div>
        <a class="wf-btn" href="https://calendly.com/gergelyracz0/30min" target="_blank" rel="noopener">{T.ctaBtn}</a>
      </div>
    </section>
  )}

  <footer class="wf-foot">
    <div class="wf-wrap">© Lead Flow Automation · {lang === "hu" ? "Rácz Gergely" : "Gergely Racz"}, PhD (Cambridge) · Budapest · <a href="/privacy/">{T.priv}</a></div>
  </footer>
  <VideoDialog lang={lang} />
</Base>

<script>
  // keep the reader's place: carry the current #anchor to the other language
  document.querySelectorAll<HTMLAnchorElement>("[data-lang-switch]").forEach((a) =>
    a.addEventListener("click", () => { if (location.hash) a.href = a.href.split("#")[0] + location.hash; }));
</script>

<style is:global>
  .wf-wrap { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  @media (min-width: 720px) { .wf-wrap { padding: 0 32px; } }
</style>

<style>
  .wf-skip { position: absolute; left: -9999px; top: 8px; z-index: 30; background: var(--color-accent); color: #fff; padding: 8px 14px; border-radius: 8px; }
  .wf-skip:focus { left: 12px; }
  .wf-top { position: sticky; top: 0; z-index: 20; background: color-mix(in oklch, var(--color-bg-deep) 90%, transparent);
    backdrop-filter: saturate(1.4) blur(10px); border-bottom: 1px solid var(--color-border); }
  .wf-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 60px; }
  .wf-mark { font-weight: 800; letter-spacing: .08em; font-size: 14px; color: var(--color-text-primary); text-decoration: none; white-space: nowrap; }
  .wf-mark span { color: var(--color-accent); }
  .wf-right { display: flex; align-items: center; gap: clamp(10px, 2vw, 22px); }
  nav { display: flex; gap: clamp(12px, 2.2vw, 24px); }
  nav a { font-size: 14px; color: #b4b4c2; text-decoration: none; padding: 6px 0; border-bottom: 1.5px solid transparent; white-space: nowrap; }
  nav a:hover { color: var(--color-text-primary); }
  nav a[aria-current="page"] { color: var(--color-text-primary); border-bottom-color: var(--color-accent); }
  nav a:focus-visible, .wf-lang:focus-visible, .wf-btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; border-radius: 6px; }
  @media (max-width: 520px) { nav a:last-child { display: none; } .wf-mark { font-size: 12.5px; } }
  @media (max-width: 440px) { .wf-mark { font-size: 11.5px; letter-spacing: .05em; } nav { gap: 12px; } nav a { font-size: 13px; }
    nav a[aria-current="page"] { display: none; } .wf-lang { padding: 5px 8px; gap: 4px; } .wf-bar { gap: 8px; } .wf-right { gap: 10px; } }
  .wf-lang { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 650; color: var(--color-text-primary); text-decoration: none;
    padding: 6px 10px; border-radius: 999px; border: 1px solid var(--color-border); transition: border-color .2s; }
  .wf-lang:hover { border-color: var(--color-accent); }
  .wf-lang svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.6; }

  .wf-cta { border-top: 1px solid var(--color-border); background:
      radial-gradient(60% 120% at 100% 0%, color-mix(in oklch, var(--color-accent-2) 10%, transparent), transparent 60%),
      radial-gradient(60% 120% at 0% 100%, color-mix(in oklch, var(--color-accent) 12%, transparent), transparent 60%); }
  .wf-cta-in { display: flex; align-items: center; justify-content: space-between; gap: 24px 40px; flex-wrap: wrap; padding-block: clamp(44px, 6vw, 80px); }
  .wf-cta h2 { font-size: clamp(26px, 3vw, 36px); margin: 0 0 10px; text-wrap: balance; }
  .wf-cta p { margin: 0; color: #b4b4c2; font-size: 16px; line-height: 1.7; max-width: 58ch; }
  .wf-btn { display: inline-block; background: var(--color-accent); color: #fff; text-decoration: none; font-weight: 650; padding: 14px 24px; border-radius: 10px; transition: background .2s; }
  .wf-btn:hover { background: var(--color-accent-hover); }
  .wf-foot { border-top: 1px solid var(--color-border); padding: 22px 0 34px; font-size: 12.5px; color: var(--color-text-secondary); }
  .wf-foot a { color: var(--color-text-secondary); }
</style>
