---
const services = [
  {
    name: "Agentic Platforms & Agent Teams",
    summary: "AI Agents",
    body: "Multi-agent systems that run real workflows end to end — every consequential action behind a human-approval gate. One agent, one task, full auditability.",
    // Lucide bot
    iconPath: "M12 8V4H8M4 12h6v6H4zM14 12h6v6h-6zM12 16H8M16 8V4h4M12 20v-4",
  },
  {
    name: "RAG & Knowledge Systems",
    summary: "Retrieval",
    body: "Retrieval-augmented generation your team can rely on: reranking, mandatory citations, refusal on low confidence — over text and image corpora at 5,000+ document scale.",
    // Lucide book-search
    iconPath: "M4 19.5A2.5 2.5 0 0 1 6.5 17H20V2H6.5A2.5 2.5 0 0 0 4 4.5zM4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5M11 8.5a2.5 2.5 0 1 0 5 0 2.5 2.5 0 1 0-5 0zM15.5 10.5 17 12",
  },
  {
    name: "MCP & Systems Integration",
    summary: "Integration",
    body: "Model Context Protocol servers and deep integrations into the systems you already run — Microsoft Business Central, HubSpot, calendars, telephony — with safe, scoped access.",
    // Lucide plug-zap
    iconPath: "M6.3 20.3a2.4 2.4 0 0 0 3.4 0L12 18l-6-6-2.3 2.3a2.4 2.4 0 0 0 0 3.4zM2 22l2.5-2.5M7.5 13.5 10 11M10.5 16.5 13 14M18 12l2.3-2.3a2.4 2.4 0 0 0 0-3.4l-2.6-2.6a2.4 2.4 0 0 0-3.4 0L12 6zM22 2l-2.5 2.5",
  },
  {
    name: "Full-Stack Product Engineering",
    summary: "Software",
    body: "From data model to shipped interface: React and TypeScript front ends, typed APIs, PostgreSQL and MySQL backends — engineered, tested, documented, handed over.",
    // Lucide layers
    iconPath: "M12 2 2 7l10 5 10-5-10-5zM2 12l10 5 10-5M2 17l10 5 10-5",
  },
  {
    name: "Applied Machine Learning",
    summary: "ML",
    body: "Not everything is an LLM problem. Neural-network modelling for constrained and embedded problems — from sensor error-compensation to price prediction.",
    // Lucide activity
    iconPath: "M22 12h-4l-3 9L9 3l-3 9H2",
  },
  {
    name: "Automation & Voice",
    summary: "Operations",
    body: "Orchestrated automation for the unglamorous work: document and email processing, outreach pipelines, AI voice intake wired live into your CRM and calendar.",
    // Lucide audio-waveform
    iconPath: "M2 13a2 2 0 0 0 2-2V7a2 2 0 0 1 4 0v13a2 2 0 0 0 4 0V4a2 2 0 0 1 4 0v13a2 2 0 0 0 4 0v-4a2 2 0 0 1 2-2",
  },
];
---
<section id="capabilities" class="border-b border-border">
  <div class="max-w-6xl mx-auto px-6 py-24">
    <h2 class="text-center mb-4">What We Build</h2>
    <p class="text-center text-text-secondary max-w-xl mx-auto mb-16">
      Six disciplines, one team, production standards.
    </p>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((s) => (
        <div class="bg-bg-elevated border border-border rounded-xl p-8 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-accent/10 transition-all">
          <div class="flex items-start gap-4 mb-4">
            <div class="flex-shrink-0 inline-flex items-center justify-center w-12 h-12 rounded-lg bg-accent/10 text-accent">
              <svg
                class="w-6 h-6"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={s.iconPath} />
              </svg>
            </div>
            <div>
              <div class="text-xs text-accent font-medium tracking-wider uppercase mb-1">{s.summary}</div>
              <h3 class="text-xl">{s.name}</h3>
            </div>
          </div>
          <p class="text-text-secondary text-base leading-relaxed">{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
