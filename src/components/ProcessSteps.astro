---
const steps = [
  {
    num: "01",
    name: "Architecture First",
    body: "Before code: scope, data map, integration points, security model and risk register — written down, reviewed with your team, agreed.",
    // Lucide drafting-compass
    iconPath: "M12 5a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM12 5v3M6.3 20.3 12 8l5.7 12.3M4 22l2.3-1.7M20 22l-2.3-1.7M8.6 15.4a7.5 7.5 0 0 0 6.8 0",
  },
  {
    num: "02",
    name: "Iterative Build",
    body: "Working software in short cycles, demonstrated on real data. Human-approval gates are designed in from the first line, not bolted on.",
    // Lucide wrench
    iconPath: "M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z",
  },
  {
    num: "03",
    name: "Verify & Hand Over",
    body: "Scripted acceptance tests, multi-persona UAT where it matters, documentation and a clean handover — your team owns and operates the result.",
    // Lucide clipboard-check
    iconPath: "M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2M9 14l2 2 4-4",
  },
];
---
<section id="process" class="border-b border-border bg-bg-elevated/20">
  <div class="max-w-6xl mx-auto px-6 py-24">
    <h2 class="text-center mb-4">How We Deliver</h2>
    <p class="text-center text-text-secondary max-w-xl mx-auto mb-16">
      Architecture first. Working software every cycle. Verified before handover.
    </p>
    <div class="grid md:grid-cols-3 gap-8 relative">
      {/* Subtle connector line between steps on desktop */}
      <div class="hidden md:block absolute top-8 left-[16.6%] right-[16.6%] h-px bg-border" aria-hidden="true"></div>

      {steps.map((s) => (
        <div class="text-center relative">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-bg-deep border-2 border-accent/30 text-accent mb-6 relative z-10">
            <svg
              class="w-7 h-7"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={s.iconPath} />
            </svg>
          </div>
          <div class="text-accent font-bold tracking-wider text-xs mb-2">{s.num}</div>
          <h3 class="mb-3">{s.name}</h3>
          <p class="text-text-secondary text-base leading-relaxed max-w-xs mx-auto">{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
