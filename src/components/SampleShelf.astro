---
// One category: text column + spotlight (a crop of the strongest part of one sample, visible without clicking),
// then a horizontal scroll-snap carousel of every sample. Documents open in a new tab, videos in the shared dialog.
// No carousel library: native scrolling (touch, trackpad, keyboard); prev/next buttons are an extra on wide screens.
import type { Category, Lang, Sample } from "../data/samples";
import { t, ui } from "../data/samples";
import sizes from "../data/img-sizes.json";
const wh = (src: string) => { const d = (sizes as Record<string, number[]>)[src]; return d ? { width: d[0], height: d[1] } : {}; };

interface Props {
  category: Category;
  lang?: Lang;
  /** link to the category sub-page */
  more?: boolean;
  /** show the spotlight panel */
  spotlight?: boolean;
  /** title override (e.g. on a product page) */
  title?: string;
  /** blurb override */
  blurb?: string;
  /** first shelf on the page: load its images eagerly */
  eager?: boolean;
}
const { category, lang = "en", more = true, spotlight = true, title, blurb, eager = false } = Astro.props;
const U = ui[lang];
const base = lang === "hu" ? "/hu" : "";
const items = category.items;
const shape = (s: Sample) => s.shape ?? (s.video ? "portrait" : "doc");
const isArticle = (s: Sample) => s.href?.startsWith("/blog/") || s.href === "/#work";
const spot = spotlight && category.spotlight !== undefined ? items[category.spotlight] : undefined;
const spotAction = spot ? (spot.video ? U.play : spot.href?.endsWith(".pdf") ? U.openReport : U.openImage) : "";
const load = eager ? "eager" : "lazy";
---

<section class="shelf" id={category.slug} aria-labelledby={`${category.slug}-title`}>
  {(category.anchors ?? []).map((a) => <span id={a} class="anchor" aria-hidden="true"></span>)}
  <div class="head" class:list={[{ solo: !spot }]}>
    <div class="intro">
      <h2 class="title" id={`${category.slug}-title`}>{title ?? t(category.title, lang)}</h2>
      <p class="blurb">{blurb ?? t(category.blurb, lang)}</p>
      {more && (
        <a class="all" href={`${base}/work/${category.slug}/`}>
          {U.seeAll(items.length)}<span class="sr">: {t(category.title, lang)}</span> <span aria-hidden="true">→</span>
        </a>
      )}
    </div>

    {spot?.hl && (
      <figure class="spot">
        {spot.video ? (
          <button type="button" class="spot-img" data-video={spot.video} data-poster={spot.img} data-title={t(spot.title, lang)} aria-label={`${U.play}: ${t(spot.title, lang)}`}>
            <picture>{spot.hl.m && <source media="(max-width: 600px)" srcset={spot.hl.m} {...wh(spot.hl.m)} />}<img src={spot.hl.img} alt="" loading={load} decoding="async" {...wh(spot.hl.img)} /></picture>
            <span class="play big" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
          </button>
        ) : (
          <a class="spot-img" href={spot.href} target="_blank" rel="noopener" aria-label={`${spotAction}: ${t(spot.title, lang)}`}>
            <picture>{spot.hl.m && <source media="(max-width: 600px)" srcset={spot.hl.m} {...wh(spot.hl.m)} />}<img src={spot.hl.img} alt="" loading={load} decoding="async" {...wh(spot.hl.img)} /></picture>
          </a>
        )}
        <figcaption>
          <span class="from">{spot.hl.from ? <b>{t(spot.hl.from, lang)}</b> : <>{U.fromPage}: <b>{t(spot.title, lang)}</b></>}{lang === "hu" && !spot.noText && <span class="en-tag">{U.assetLang}</span>}</span>
          <span class="cap">{t(spot.hl.cap, lang)}</span>
          {spot.video ? (
            <button type="button" class="act" data-video={spot.video} data-poster={spot.img} data-title={t(spot.title, lang)}>{spotAction} <span aria-hidden="true">→</span></button>
          ) : (
            <a class="act" href={spot.href} target="_blank" rel="noopener">{spotAction} <span aria-hidden="true">→</span></a>
          )}
        </figcaption>
      </figure>
    )}
  </div>

  <div class="rail" data-rail>
    <div class="nav">
      <button type="button" class="arrow" data-prev aria-label={`${U.prev}: ${t(category.title, lang)}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
      </button>
      <button type="button" class="arrow" data-next aria-label={`${U.next}: ${t(category.title, lang)}`}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
      </button>
    </div>
    <ul class="track" tabindex="0" aria-label={`${t(category.title, lang)}, ${U.scroll}`} data-track>
      {items.map((s, i) => (
        <li class={`item ${shape(s)}`} id={s.id}>
          {s.video ? (
            <button type="button" class="open" data-video={s.video} data-poster={s.img} data-title={t(s.title, lang)} aria-label={`${U.play}: ${t(s.title, lang)}`}>
              <span class="thumb">
                <img src={s.img} alt="" loading={eager && i < 5 ? "eager" : "lazy"} decoding="async" />
                <span class="play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
              </span>
              <span class="kind">{t(s.kind, lang)}</span>
              <span class="name">{t(s.title, lang)}</span>
              {s.meta && <span class="meta">{t(s.meta, lang)}</span>}
            </button>
          ) : (
            <a class="open" href={s.href} target={isArticle(s) ? undefined : "_blank"} rel={isArticle(s) ? undefined : "noopener"}>
              <span class="thumb"><img src={s.img} alt="" loading={eager && i < 5 ? "eager" : "lazy"} decoding="async" /></span>
              <span class="kind">{t(s.kind, lang)}</span>
              <span class="name">{t(s.title, lang)}</span>
              {s.meta && <span class="meta">{t(s.meta, lang)}</span>}
            </a>
          )}
          {lang === "hu" && !s.noText && <span class="en-tag">{U.assetLang}</span>}
          {s.extra && (
            <span class="extra">{s.extra.map((x) => <a href={x.href} target="_blank" rel="noopener">{t(x.label, lang)}</a>)}</span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  // Prev/next scroll one viewport of the track and disable at the ends; native scroll does everything else.
  function wire(rail: HTMLElement) {
    const track = rail.querySelector<HTMLElement>("[data-track]")!;
    const prev = rail.querySelector<HTMLButtonElement>("[data-prev]")!;
    const next = rail.querySelector<HTMLButtonElement>("[data-next]")!;
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
      rail.classList.toggle("fits", max <= 0);
      rail.classList.toggle("at-end", track.scrollLeft >= max);
    };
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const step = (dir: number) => track.scrollBy({ left: dir * track.clientWidth * 0.85, behavior: reduce ? "auto" : "smooth" });
    prev.addEventListener("click", () => step(-1));
    next.addEventListener("click", () => step(1));
    track.addEventListener("scroll", update, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  }
  document.querySelectorAll<HTMLElement>("[data-rail]").forEach(wire);
</script>

<style>
  .shelf { position: relative; padding-block: clamp(36px, 5vw, 64px); border-top: 1px solid var(--color-border); scroll-margin-top: 150px; }
  .anchor { position: absolute; top: 0; scroll-margin-top: 150px; }
  .item[id] { scroll-margin-top: 130px; }

  .head { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(20px, 4vw, 56px); align-items: start; margin-bottom: clamp(22px, 3vw, 32px); }
  .head.solo { grid-template-columns: minmax(0, 1fr); }
  .head.solo .blurb { max-width: 68ch; }
  @media (max-width: 880px) { .head { grid-template-columns: minmax(0, 1fr); } }

  .intro { display: flex; flex-direction: column; gap: 12px; }
  .title { font-size: clamp(26px, 3vw, 36px); font-weight: 750; letter-spacing: -0.025em; line-height: 1.1; color: var(--color-text-primary); text-wrap: balance; margin: 0; }
  .blurb { font-size: 16px; line-height: 1.7; color: #b4b4c2; margin: 0; max-width: 48ch; text-wrap: pretty; }
  .all { font-size: 14.5px; font-weight: 600; color: var(--color-accent); text-decoration: none; width: fit-content; margin-top: 2px; }
  .all:hover { color: var(--color-accent-hover); }
  .all:focus-visible, .act:focus-visible, .spot-img:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 3px; border-radius: 6px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .all span[aria-hidden], .act span[aria-hidden] { display: inline-block; transition: transform .25s cubic-bezier(.22, 1, .36, 1); }
  .all:hover span[aria-hidden], .act:hover span[aria-hidden] { transform: translateX(3px); }

  /* spotlight: the evidence panel */
  .spot { margin: 0; display: grid; gap: 14px; padding: 12px; border-radius: 16px; background: var(--color-bg-elevated); border: 1px solid var(--color-border); }
  .spot-img { all: unset; cursor: pointer; position: relative; display: block; border-radius: 10px; overflow: hidden; background: #fff; max-height: 360px; }
  .spot-img picture { display: block; }
  @media (max-width: 600px) { .spot-img, .spot-img img { max-height: none; } .spot-img img { object-fit: contain; } }
  .spot-img img { display: block; width: 100%; height: auto; max-height: 360px; object-fit: cover; object-position: top; transition: transform .6s cubic-bezier(.22, 1, .36, 1); }
  .spot-img:hover img { transform: scale(1.015); }
  .spot figcaption { display: flex; flex-direction: column; gap: 6px; padding: 0 6px 6px; }
  .from { font-size: 12.5px; color: var(--color-text-secondary); }
  .from b { color: var(--color-text-primary); font-weight: 600; }
  .cap { font-size: 15px; line-height: 1.55; color: var(--color-text-primary); text-wrap: pretty; }
  .act { all: unset; cursor: pointer; font-size: 14px; font-weight: 600; color: var(--color-accent); width: fit-content; margin-top: 2px; }
  .act:hover { color: var(--color-accent-hover); }

  .rail { position: relative; min-width: 0; }
  .nav { display: flex; justify-content: flex-end; gap: 8px; margin-bottom: 12px; }
  @media (hover: none), (max-width: 700px) { .nav { display: none; } }
  .fits .nav { display: none; }
  .arrow { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; cursor: pointer;
    background: var(--color-bg-elevated); border: 1px solid var(--color-border); color: var(--color-text-primary); transition: border-color .2s, opacity .2s; }
  .arrow:hover:not(:disabled) { border-color: var(--color-accent); }
  .arrow:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .arrow:disabled { opacity: .3; cursor: default; }
  .arrow svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* the right edge fades so a cut-off card reads as "more to the side" */
  .rail::after { content: ""; position: absolute; right: 0; top: 50px; bottom: 14px; width: 56px; pointer-events: none;
    background: linear-gradient(to right, transparent, var(--color-bg-deep)); transition: opacity .3s; }
  .fits::after, .at-end::after { opacity: 0; }
  @media (hover: none), (max-width: 700px) { .rail::after { top: 0; } }

  .track { display: flex; gap: 18px; list-style: none; margin: 0; padding: 4px 4px 16px; overflow-x: auto; scroll-snap-type: x mandatory;
    scroll-padding-inline: 4px; overscroll-behavior-x: contain; scrollbar-width: thin; scrollbar-color: var(--color-border) transparent; border-radius: 10px; }
  .track:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  .item { flex: 0 0 auto; scroll-snap-align: start; display: flex; flex-direction: column; gap: 8px; }
  .item.doc { width: clamp(168px, 18vw, 210px); }
  .item.portrait { width: clamp(160px, 17vw, 200px); }
  .item.wide { width: clamp(250px, 30vw, 340px); }
  .item.square { width: clamp(180px, 20vw, 230px); }

  .open { all: unset; cursor: pointer; display: flex; flex-direction: column; gap: 6px; border-radius: 12px; }
  .open:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .thumb { position: relative; display: block; overflow: hidden; border-radius: 10px; background: var(--color-bg-subtle); border: 1px solid var(--color-border);
    transition: border-color .2s, transform .35s cubic-bezier(.22, 1, .36, 1), box-shadow .35s; }
  .doc .thumb { aspect-ratio: 3 / 4; }
  .portrait .thumb { aspect-ratio: 4 / 5; }
  .portrait .open[data-video] .thumb { aspect-ratio: 9 / 16; }
  .wide .thumb { aspect-ratio: 16 / 9; }
  .square .thumb { aspect-ratio: 1; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .open:hover .thumb, .open:focus-visible .thumb { border-color: color-mix(in oklch, var(--color-accent) 70%, transparent); transform: translateY(-3px);
    box-shadow: 0 14px 30px -18px color-mix(in oklch, var(--color-accent) 60%, transparent); }
  .play { position: absolute; left: 10px; bottom: 10px; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center;
    background: rgb(10 10 15 / .74); border: 1px solid rgb(255 255 255 / .2); }
  .play.big { left: 50%; top: 50%; bottom: auto; width: 64px; height: 64px; transform: translate(-50%, -50%); background: rgb(10 10 15 / .66); }
  .play svg { width: 16px; height: 16px; fill: #fff; margin-left: 2px; }
  .play.big svg { width: 24px; height: 24px; }

  .kind { font-size: 12px; font-weight: 600; color: var(--color-accent); }
  .name { font-size: 15px; font-weight: 650; line-height: 1.35; color: var(--color-text-primary); text-wrap: pretty; }
  .meta { font-size: 13px; line-height: 1.45; color: #a8a8b8; }
  .en-tag { display: inline-block; width: fit-content; font-size: 11px; font-weight: 600; color: var(--color-text-secondary); border: 1px solid var(--color-border);
    border-radius: 999px; padding: 1px 8px; margin-left: 0; }
  .from .en-tag { margin-left: 8px; vertical-align: 1px; }
  .extra { display: flex; flex-wrap: wrap; gap: 4px 12px; font-size: 13px; }
  .extra a { color: var(--color-accent); text-decoration: none; }
  .extra a:hover { text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) { .thumb, .spot-img picture { display: block; }
  .spot-img img { transition: none; } }
</style>
