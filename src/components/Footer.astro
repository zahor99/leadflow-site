---
import { PRODUCTS } from "../data/products";
const base = import.meta.env.BASE_URL;
---
<footer id="contact" class="border-t border-border">
  <div class="max-w-6xl mx-auto px-6 py-12 grid md:grid-cols-2 gap-8 items-start">
    <div>
      <a href="/" class="inline-block mb-4">
        <img
          src={`${base}logo/leadflow-lockup.png`}
          alt="LeadFlow Automation"
          width="189"
          height="119"
          class="h-24 w-auto"
          loading="lazy"
        />
      </a>
      <p class="text-text-secondary text-sm leading-relaxed max-w-md">
        Full-stack software development with AI agent integration —
        for small teams to large enterprises.
      </p>
      <nav aria-label="Products" class="mt-6 text-sm">
        <p class="text-text-primary font-medium mb-2">Products</p>
        <ul class="flex flex-col gap-1.5">
          {PRODUCTS.map((p) => (
            <li><a href={p.href} class="text-text-secondary hover:text-text-primary transition-colors">{p.name} <span class="opacity-60">· {p.note}</span></a></li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="text-left md:text-right">
      <a
        href="https://calendly.com/gergelyracz0/30min" target="_blank" rel="noopener"
        class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-accent text-white font-medium hover:bg-accent-hover transition-all hover:scale-[1.02] shadow-lg shadow-accent/20"
      >
        Book a call →
      </a>
      <p class="text-text-secondary text-xs mt-3">
        A 30-minute technical conversation — no obligation.
      </p>
      <p class="text-text-secondary text-sm mt-6">
        Customer service:
        <a href="mailto:gergely@startleadflowautomation.com" class="text-text-primary hover:text-accent transition-colors break-all">gergely@startleadflowautomation.com</a><br />
        <a href="tel:+36308136202" class="text-text-primary hover:text-accent transition-colors">+36 30 813 6202</a><br />
        <span class="text-xs">Monday to Friday, answer within 24 hours · <a href="/contact/" class="underline hover:text-text-primary">Contact page</a></span>
      </p>
    </div>
  </div>
  <div class="border-t border-border">
    <div class="max-w-6xl mx-auto px-6 py-6 flex flex-col gap-2 text-xs text-text-secondary">
      <span>
        LeadFlow Automation is a brand of <strong class="text-text-primary font-medium">BioInsight Lab Inc.</strong>
        · 226 Halyard Way, Kanata, Ontario K2T 0L3, Canada
        · Canada Corporation No. 1606251-2
        · Products on this website are sold by BioInsight Lab Inc.
      </span>
      <nav aria-label="Policies" class="flex flex-wrap gap-x-4 gap-y-1">
        <a href="/terms/agency-os-real-estate/" class="hover:text-text-primary">Subscription terms</a>
        <a href="/refunds/" class="hover:text-text-primary">Refund and cancellation policy</a>
        <a href="/terms/" class="hover:text-text-primary">Terms of service (online tools)</a>
        <a href="/privacy/" class="hover:text-text-primary">Privacy notice</a>
        <a href="/contact/" class="hover:text-text-primary">Contact</a>
      </nav>
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <span>© 2026 BioInsight Lab Inc. All rights reserved.</span>
        <span class="opacity-70">Built with Astro · Hosted on GitHub Pages</span>
      </div>
    </div>
  </div>
</footer>
