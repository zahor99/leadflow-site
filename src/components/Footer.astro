---
const base = import.meta.env.BASE_URL;
---
<footer id="contact" class="border-t border-border">
  <div class="max-w-6xl mx-auto px-6 py-12 grid md:grid-cols-2 gap-8 items-start">
    <div>
      <a href="/" class="inline-block mb-4">
        <img
          src={`${base}logo/leadflow-lockup.png`}
          alt="Lead Flow Automation"
          width="189"
          height="119"
          class="h-24 w-auto"
          loading="lazy"
        />
      </a>
      <p class="text-text-secondary text-sm leading-relaxed max-w-md">
        Full-stack software development with AI agent integration —
        for small teams to large enterprises.
      </p>
    </div>
    <div class="text-left md:text-right">
      <a
        href="https://calendly.com/gergely-estateops/30min" target="_blank" rel="noopener"
        class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-accent text-white font-medium hover:bg-accent-hover transition-all hover:scale-[1.02] shadow-lg shadow-accent/20"
      >
        Book a call →
      </a>
      <p class="text-text-secondary text-xs mt-3">
        A 30-minute technical conversation — no obligation.
      </p>
    </div>
  </div>
  <div class="border-t border-border">
    <div class="max-w-6xl mx-auto px-6 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-text-secondary">
      <span>© 2026 Lead Flow Automation. All rights reserved.</span>
      <span class="opacity-70">Built with Astro · Hosted on GitHub Pages</span>
    </div>
  </div>
</footer>
