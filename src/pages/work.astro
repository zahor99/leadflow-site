---
// Samples hub: one carousel per category, every sample opens (PDF, image, article or video).
// Data: src/data/samples.ts. Category pages: /work/<slug>/. Unlisted (noindex): linked from proposals and the
// AI marketing desk page; old anchors (#keyword-research, #seo-audit, #ugc ...) still land on the right sample.
import WorkFrame from "../components/WorkFrame.astro";
import SampleShelf from "../components/SampleShelf.astro";
import { categories, total } from "../data/samples";

const G = "/work/gallery";
// hero collage: one real piece per medium, each jumps to its shelf
const collage = [
  { img: `${G}/social/medspa-myth-or-fact.webp`, to: "#social", cls: "c1", alt: "Instagram post for a demo med spa" },
  { img: "/work/reports/seo-desk/seo-desk-baseline-leadflowautomation.webp", to: "#seo", cls: "c2", alt: "SEO Desk baseline report cover" },
  { img: "/work/videos/scalepod-ugc.jpg", to: "#video", cls: "c3", alt: "UGC ad still with an AI presenter" },
  { img: `${G}/social/b2b-carousel-1.webp`, to: "#social", cls: "c4", alt: "LinkedIn carousel slide" },
  { img: `${G}/merch/pod-4-listing.webp`, to: "#products", cls: "c5", alt: "Listing photo of a printed jacket" },
  { img: "/work/whitepapers/erp-discovery-agent-cover.png", to: "#papers", cls: "c6", alt: "White paper cover" },
];
---

<WorkFrame
  title="Work samples"
  description="Open real samples: SEO reports, research, articles, social posts, UGC ads and videos, white papers, lead magnets, product mockups and print design, by Lead Flow Automation."
>
  <section class="hero">
    <div class="wf-wrap hero-in">
      <div class="copy">
        <h1>Open the work before you book the call</h1>
        <p class="lede">
          {total} samples in {categories.length} categories, each one finished and clickable: reports open as PDFs,
          videos play here, posts open full size. All of it is our own work, made for our own products or for
          made-up demo brands. Client work stays private.
        </p>
        <p class="who">Made by Gergely Racz (PhD, Cambridge) and a set of AI agents he built, with every piece checked by a person before it ships.</p>
      </div>
      <div class="collage" aria-label="A few samples">
        {collage.map((c) => (
          <a class={`tile ${c.cls}`} href={c.to}><img src={c.img} alt={c.alt} loading="eager" decoding="async" /></a>
        ))}
      </div>
    </div>
  </section>

  <nav class="cats" aria-label="Sample categories">
    <div class="wf-wrap cats-in">
      {categories.map((c) => (
        <a href={`#${c.slug}`}>{c.title}<span>{c.items.length}</span></a>
      ))}
    </div>
  </nav>

  <div class="wf-wrap shelves">
    {categories.map((c) => <SampleShelf category={c} items={c.items} />)}
  </div>
</WorkFrame>

<style>
  .hero { padding-block: clamp(36px, 6vw, 80px) clamp(28px, 4vw, 48px); overflow: hidden; }
  .hero-in { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  @media (max-width: 900px) { .hero-in { grid-template-columns: minmax(0, 1fr); } }
  h1 { font-size: clamp(36px, 5.4vw, 64px); line-height: 1.04; letter-spacing: -0.03em; margin: 0 0 20px; text-wrap: balance; }
  .lede { font-size: clamp(16px, 1.4vw, 18px); line-height: 1.7; color: var(--color-text-secondary); max-width: 58ch; margin: 0 0 14px; text-wrap: pretty; }
  .who { font-size: 14.5px; line-height: 1.6; color: var(--color-text-primary); max-width: 54ch; margin: 0; }

  /* asymmetric contact sheet of real pieces */
  .collage { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); grid-template-rows: repeat(6, clamp(42px, 5.4vw, 66px)); gap: 10px; }
  .tile { display: block; overflow: hidden; border-radius: 12px; border: 1px solid var(--color-border); background: var(--color-bg-subtle);
    animation: rise .8s cubic-bezier(.22, 1, .36, 1) both; transition: transform .35s cubic-bezier(.22, 1, .36, 1), border-color .2s; }
  .tile img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .tile:hover { transform: translateY(-4px); border-color: var(--color-accent); }
  .c1 { grid-area: 1 / 1 / 5 / 3; animation-delay: .05s; }
  .c2 { grid-area: 1 / 3 / 4 / 5; animation-delay: .12s; }
  .c3 { grid-area: 1 / 5 / 6 / 7; animation-delay: .19s; }
  .c4 { grid-area: 4 / 3 / 7 / 5; animation-delay: .26s; }
  .c5 { grid-area: 5 / 1 / 7 / 3; animation-delay: .33s; }
  .c6 { grid-area: 6 / 5 / 7 / 7; animation-delay: .4s; }
  .c6 img { object-position: center 30%; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px) scale(.98); } to { opacity: 1; transform: none; } }

  .cats { position: sticky; top: 60px; z-index: 10; background: color-mix(in oklch, var(--color-bg-deep) 92%, transparent);
    backdrop-filter: blur(10px); border-block: 1px solid var(--color-border); }
  .cats-in { display: flex; gap: 6px; overflow-x: auto; padding-block: 10px; scrollbar-width: none; }
  .cats-in::-webkit-scrollbar { display: none; }
  .cats a { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--color-text-secondary);
    text-decoration: none; padding: 7px 12px; border-radius: 999px; border: 1px solid transparent; transition: color .2s, border-color .2s, background .2s; }
  .cats a:hover { color: var(--color-text-primary); border-color: var(--color-border); background: var(--color-bg-elevated); }
  .cats span { font-size: 11.5px; font-weight: 650; color: var(--color-text-primary); background: var(--color-bg-subtle); border-radius: 999px; padding: 1px 7px; }

  .shelves { padding-bottom: 32px; }
  .shelves :global(.shelf) { scroll-margin-top: 118px; }
  .shelves :global(.shelf:first-child) { border-top: 0; }
</style>
