---
import Base from "../layouts/Base.astro";
---

<Base
  title="Your AI Starter Pack"
  description="Download the GDPR-AI Checklist and the AI Leverage Blueprint."
  noindex={true}
>
  <header class="top">
    <div class="wrap">
      <a class="wordmark" href="/">LEADFLOW<span>AUTOMATION</span></a>
    </div>
  </header>

  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">Thank you — here's your pack</div>
      <h1>Your AI starter pack is <em>ready now</em>.</h1>
      <p class="lead">
        No waiting on email (a copy of these links is on its way to your inbox too).
        Both open on your phone.
      </p>

      <div class="dl">
        <a class="dl-card" href="/downloads/leadflow-gdpr-ai-checklist.pdf">
          <span class="kind">PDF · 1 page</span>
          <strong>The GDPR-AI Checklist</strong>
          <span class="desc">10 questions to ask before any AI tool touches company data.</span>
          <span class="get">Download →</span>
        </a>
        <a class="dl-card" href="/downloads/leadflow-ai-leverage-blueprint.pdf">
          <span class="kind">PDF · executive brief</span>
          <strong>The AI Leverage Blueprint</strong>
          <span class="desc">Where AI belongs in an established company — how AI, code, automation and people divide the work, and how to choose your first operational win.</span>
          <span class="get">Download →</span>
        </a>
      </div>

      <div class="map">
        <div class="eyebrow">The next step, if you want it</div>
        <h2>Your free AI Operating Map</h2>
        <p>
          The pack tells you what to look at. The Operating Map tells you what to do: where AI belongs in
          <em>your</em> company, where it must not go, and the one first move worth funding. One 30-minute
          working session — a written map within 5 business days. No sales sequence, no obligation.
        </p>
        <a class="btn" href="https://calendly.com/gergely-estateops/30min" target="_blank" rel="noopener">Book the 30-minute session →</a>
      </div>

      <p class="more">Curious what we build? <a href="/services">See the services page</a>.</p>
    </div>
  </section>

  <footer class="bottom">
    <div class="wrap">
      Lead Flow Automation · Gergely Racz · <a href="/privacy">Privacy notice</a>
    </div>
  </footer>
</Base>

<style>
  .wrap { max-width: 720px; margin: 0 auto; padding: 0 20px; }
  .top { border-bottom: 1px solid var(--color-border); padding: 18px 0; }
  .wordmark { font-weight: 800; letter-spacing: 0.08em; font-size: 15px; color: var(--color-text-primary); text-decoration: none; }
  .wordmark span { color: var(--color-accent); }
  .hero { padding: 56px 0 40px; }
  .eyebrow { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-accent); font-weight: 700; margin-bottom: 14px; }
  h1 { font-weight: 800; color: var(--color-text-primary); font-size: clamp(28px, 5.5vw, 40px); line-height: 1.14; }
  h1 em { font-style: normal; color: var(--color-accent); }
  h2 { font-weight: 700; color: var(--color-text-primary); font-size: 24px; margin-bottom: 10px; }
  .lead { margin-top: 14px; font-size: 16px; color: var(--color-text-secondary); }
  .dl { display: grid; gap: 14px; margin-top: 28px; }
  .dl-card { display: block; background: var(--color-bg-elevated); border: 1px solid var(--color-border); border-left: 4px solid var(--color-accent); border-radius: 10px; padding: 20px 22px; text-decoration: none; }
  .dl-card:hover { border-color: var(--color-accent); }
  .dl-card .kind { display: block; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent); font-weight: 700; margin-bottom: 6px; }
  .dl-card strong { display: block; font-size: 18px; color: var(--color-text-primary); margin-bottom: 6px; }
  .dl-card .desc { display: block; font-size: 13.5px; color: var(--color-text-secondary); line-height: 1.5; }
  .dl-card .get { display: inline-block; margin-top: 10px; font-size: 14px; font-weight: 700; color: var(--color-accent); }
  .map { margin-top: 36px; background: var(--color-bg-subtle); border: 1px solid var(--color-accent); border-radius: 10px; padding: 24px; }
  .map p { font-size: 14px; color: var(--color-text-secondary); line-height: 1.55; }
  .btn { display: inline-block; margin-top: 16px; background: var(--color-accent); color: #06131f; font-weight: 700; font-size: 15px; padding: 13px 24px; border-radius: 6px; text-decoration: none; }
  .btn:hover { background: var(--color-accent-hover); }
  .more { margin-top: 26px; font-size: 13.5px; color: var(--color-text-secondary); }
  .more a { color: var(--color-accent); }
  .bottom { border-top: 1px solid var(--color-border); margin-top: 30px; padding: 22px 0 34px; font-size: 12px; color: var(--color-text-secondary); }
  .bottom a { color: var(--color-text-secondary); }
</style>
