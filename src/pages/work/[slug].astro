---
// One category, every sample in a wrapping grid (the hub shows them as a carousel). Generated from samples.ts.
import WorkFrame from "../../components/WorkFrame.astro";
import { categories, type Sample } from "../../data/samples";

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug } }));
}
const { slug } = Astro.params;
const cat = categories.find((c) => c.slug === slug)!;
const others = categories.filter((c) => c.slug !== slug);
const shape = (s: Sample) => s.shape ?? (s.video ? "portrait" : "doc");
const external = (s: Sample) => !s.href?.startsWith("/blog/") && s.href !== "/#work";
---

<WorkFrame title={`${cat.title}: work samples`} description={cat.blurb}>
  <section class="wf-wrap head">
    <a class="back" href="/work/">← All samples</a>
    <h1>{cat.title}</h1>
    <p class="lede">{cat.blurb}</p>
    {cat.price && <p class="price">{cat.price} <a href="/seo-desk/">See the SEO Desk →</a></p>}
  </section>

  <section class="wf-wrap">
    <ul class="grid" data-shape-mix>
      {cat.items.map((s) => (
        <li class={`it ${shape(s)}`} id={s.id}>
          {s.video ? (
            <button type="button" class="open" data-video={s.video} data-poster={s.img} data-title={s.title} aria-label={`Play video: ${s.title}`}>
              <span class="thumb"><img src={s.img} alt="" loading="lazy" decoding="async" /><span class="play" aria-hidden="true">▶</span></span>
              <span class="kind">{s.kind}</span><span class="name">{s.title}</span>{s.meta && <span class="meta">{s.meta}</span>}
            </button>
          ) : (
            <a class="open" href={s.href} target={external(s) ? "_blank" : undefined} rel={external(s) ? "noopener" : undefined}>
              <span class="thumb"><img src={s.img} alt="" loading="lazy" decoding="async" /></span>
              <span class="kind">{s.kind}</span><span class="name">{s.title}</span>{s.meta && <span class="meta">{s.meta}</span>}
            </a>
          )}
          {s.extra && <span class="extra">{s.extra.map((x) => <a href={x.href} target="_blank" rel="noopener">{x.label}</a>)}</span>}
        </li>
      ))}
    </ul>
  </section>

  <section class="wf-wrap more" aria-label="Other categories">
    <h2>More samples</h2>
    <div class="chips">{others.map((c) => <a href={`/work/${c.slug}/`}>{c.title} <span>{c.items.length}</span></a>)}</div>
  </section>
</WorkFrame>

<style>
  .head { padding-block: clamp(32px, 5vw, 64px) clamp(20px, 3vw, 32px); }
  .back { font-size: 14px; color: var(--color-text-secondary); text-decoration: none; }
  .back:hover { color: var(--color-accent); }
  h1 { font-size: clamp(34px, 5vw, 58px); line-height: 1.05; letter-spacing: -0.03em; margin: 14px 0 14px; text-wrap: balance; }
  .lede { font-size: 17px; line-height: 1.7; color: var(--color-text-secondary); max-width: 62ch; margin: 0; }
  .price { margin: 14px 0 0; font-size: 15px; color: var(--color-text-primary); }
  .price a { color: var(--color-accent); text-decoration: none; margin-left: 6px; }

  .grid { list-style: none; margin: 0; padding: 0 0 24px; display: grid; gap: 28px 20px;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); align-items: start; }
  .it.wide { grid-column: span 2; }
  @media (max-width: 460px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 12px; } .it.wide { grid-column: 1 / -1; } }
  .open { all: unset; cursor: pointer; display: flex; flex-direction: column; gap: 6px; border-radius: 12px; }
  .open:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  .thumb { position: relative; display: block; overflow: hidden; border-radius: 10px; background: var(--color-bg-subtle); border: 1px solid var(--color-border);
    transition: border-color .2s, transform .35s cubic-bezier(.22, 1, .36, 1); }
  .doc .thumb { aspect-ratio: 3 / 4; } .portrait .thumb { aspect-ratio: 4 / 5; } .wide .thumb { aspect-ratio: 16 / 9; } .square .thumb { aspect-ratio: 1; }
  .portrait .open[data-video] .thumb { aspect-ratio: 9 / 16; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .open:hover .thumb { border-color: var(--color-accent); transform: translateY(-3px); }
  .play { position: absolute; left: 10px; bottom: 10px; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center;
    background: rgb(10 10 15 / .72); color: #fff; font-size: 13px; border: 1px solid rgb(255 255 255 / .18); }
  .kind { font-size: 12px; font-weight: 600; color: var(--color-accent); }
  .name { font-size: 15px; font-weight: 650; line-height: 1.35; color: var(--color-text-primary); text-wrap: pretty; }
  .meta { font-size: 13px; color: var(--color-text-secondary); line-height: 1.45; }
  .extra { display: flex; gap: 12px; font-size: 13px; } .extra a { color: var(--color-accent); text-decoration: none; }

  .more { padding-block: 24px 48px; border-top: 1px solid var(--color-border); margin-top: 16px; }
  .more h2 { font-size: 20px; margin: 20px 0 14px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips a { font-size: 14px; color: var(--color-text-primary); text-decoration: none; padding: 8px 14px; border-radius: 999px;
    border: 1px solid var(--color-border); background: var(--color-bg-elevated); transition: border-color .2s; }
  .chips a:hover { border-color: var(--color-accent); }
  .chips span { color: var(--color-text-secondary); font-size: 12.5px; margin-left: 4px; }
</style>
