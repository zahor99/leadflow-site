---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  /** Extra JSON-LD blocks (already-stringified objects). */
  schema?: string[];
}

const SITE_URL = "https://www.leadflowautomation.net";
const SITE_NAME = "Lead Flow Automation";
const DEFAULT_OG = `${SITE_URL}/og-default.png`;

const {
  title,
  description = "Full-stack software development with AI agent integration — agentic platforms, RAG knowledge systems, MCP development, and ERP/CRM integration for enterprises.",
  ogImage = DEFAULT_OG,
  canonical = Astro.url.href,
  schema = [],
} = Astro.props;

const fullTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;

// Default Organization schema injected on every page.
const orgSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: SITE_NAME,
  url: SITE_URL,
  description:
    "Full-stack software development with AI agent integration — agentic platforms, RAG and knowledge systems, MCP development, and ERP/CRM integration for small, medium and large enterprises.",
  founder: {
    "@type": "Person",
    name: "Gergely Racz",
    honorificSuffix: "PhD",
    alumniOf: "University of Cambridge",
    jobTitle: "Founder & Principal Engineer",
    sameAs: ["https://www.youtube.com/@AILeadFlowAutomations"],
    image: `${SITE_URL}/images/gergely-racz.webp`,
  },
  sameAs: ["https://www.youtube.com/@AILeadFlowAutomations"],
  knowsAbout: [
    "AI agents",
    "Retrieval-augmented generation",
    "Model Context Protocol",
    "ERP integration",
    "Full-stack software development",
    "Machine learning",
  ],
  areaServed: ["US", "EU", "APAC"],
});
---
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Brand mark favicons (wave mark from the Lead Flow Automation logo) -->
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Theme -->
    <meta name="theme-color" content="#0A0A0F" />

    <!-- Schema -->
    <script type="application/ld+json" set:html={orgSchema} />
    {schema.map((block) => (
      <script type="application/ld+json" set:html={block} />
    ))}

    <!-- Analytics placeholder (swap to Plausible/Umami at launch) -->
    <!-- <script defer data-domain="www.leadflowautomation.net" src="https://plausible.io/js/script.js"></script> -->
  </head>
  <body class="bg-bg-deep text-text-primary">
    <slot />
  </body>
</html>
